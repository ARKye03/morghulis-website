---
import { Image } from "astro:assets";
import morghulisLogo from "@assets/morghulis.png";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Morghulis</title>
  </head>
  <body>
    <div class="relative h-screen">
      <div class="absolute inset-0">
        <div
          class="absolute inset-0 -z-10 h-full w-full bg-white bg-[linear-gradient(to_right,#f0f0f0_1px,transparent_1px),linear-gradient(to_bottom,#f0f0f0_1px,transparent_1px)] bg-size-[6rem_4rem] dark:bg-slate-950 dark:bg-none [&>div]:absolute [&>div]:inset-0 [&>div]:bg-[radial-gradient(circle_800px_at_100%_200px,#d5c5ff,transparent)] dark:[&>div]:bottom-0 dark:[&>div]:right-[-20%] dark:[&>div]:top-[-10%] dark:[&>div]:h-[500px] dark:[&>div]:w-[500px] dark:[&>div]:rounded-full dark:[&>div]:bg-[radial-gradient(circle_farthest-side,rgba(255,0,182,.15),rgba(255,255,255,0))]"
        >
          <div></div>
        </div>
      </div>

      <div class="relative z-10 max-w-7xl mx-auto px-4 py-2">
        <header class="flex w-full p-4">
          <a href="/" class="flex items-center gap-2">
            <Image src={morghulisLogo} alt="Morghulis Logo" class="h-12 w-12" />
            <h1 class="text-2xl font-bold">Morghulis</h1>
          </a>

          <a href="/install" class="ml-auto self-center text-lg underline"> </a>
        </header>
        <slot />
      </div>
    </div>
  </body>
</html>
