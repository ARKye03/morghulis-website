---
import { Image } from "astro:assets";
import morghulisLogo from "@assets/morghulis.png";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Morghulis</title>
  </head>
  <body>
    <div class="max-w-7xl mx-auto px-4 py-2">
      <header class="flex w-full p-4">
        <a href="/" class="flex items-center gap-2">
          <Image src={morghulisLogo} alt="Morghulis Logo" class="h-12 w-12" />
          <h1 class="text-2xl font-bold">Morghulis</h1>
        </a>

        <a href="/install" class="ml-auto self-center text-lg underline"
          >Install
        </a>
      </header>
      <slot />
    </div>

    <style>
      html,
      body {
        margin: 0;
        width: 100%;
        height: 100%;
      }
    </style>
  </body>
</html>
