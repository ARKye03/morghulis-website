---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "@components/Header.astro";
import morghulisMain from "@assets/morghulisMain.webp";
import { Image } from "astro:assets";
import InstallationSteps from "@components/InstallationSteps.astro";
import FAQ from "@components/FAQ.astro";
---

<BaseLayout title="Morghulis Installation Guide">
  <Header />
  <main class="flex-1 px-4 py-10 md:px-10 lg:px-20">
    <div class="mx-auto max-w-6xl">
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-3 lg:grid-rows-3">
        <div
          class="col-span-1 lg:col-span-3 rounded-xl bg-card-light dark:bg-card-dark p-6 md:p-8 flex flex-col justify-center"
        >
          <h1 class="text-4xl md:text-5xl font-bold tracking-tighter mb-4">
            Installation Guide
          </h1>
          <p
            class="text-base md:text-lg text-subtext-light dark:text-subtext-dark max-w-3xl"
          >
            Your step-by-step guide to setting up Morghulis, our GTK-based
            graphical desktop shell for Linux. Follow the instructions for your
            distribution to get started.
          </p>
        </div>

        <div
          class="col-span-1 lg:col-span-1 rounded-xl bg-card-light dark:bg-card-dark p-6"
        >
          <h2 class="text-xl font-bold mb-4">Prerequisites</h2>
          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <span
                class="iconify lucide--layers text-primary-light dark:text-primary-dark mt-1 text-xl"
              ></span>
              <div>
                <h3 class="font-bold">GTK 4.x+</h3>
                <p class="text-sm text-subtext-light dark:text-subtext-dark">
                  Ensure you have the latest GTK libraries installed.
                </p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span
                class="iconify lucide--git-branch text-primary-light dark:text-primary-dark mt-1 text-xl"
              ></span>
              <div>
                <h3 class="font-bold">Systemd</h3>
                <p class="text-sm text-subtext-light dark:text-subtext-dark">
                  A systemd-based Linux distribution is required.
                </p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span
                class="iconify lucide--hard-drive text-primary-light dark:text-primary-dark mt-1 text-xl"
              ></span>
              <div>
                <h3 class="font-bold">Disk Space</h3>
                <p class="text-sm text-subtext-light dark:text-subtext-dark">
                  At least 2GB of free disk space is recommended.
                </p>
              </div>
            </div>
          </div>
        </div>

        <InstallationSteps />

        <div
          class="col-span-1 lg:col-span-1 rounded-xl bg-card-light dark:bg-card-dark overflow-hidden"
        >
          <Image
            alt="A screenshot of the Morghulis desktop environment"
            src={morghulisMain}
          />
        </div>

        <div
          class="col-span-1 lg:col-span-1 rounded-xl bg-card-light dark:bg-card-dark p-6"
        >
          <h2 class="text-xl font-bold mb-4">Post-Installation</h2>
          <ul
            class="list-disc list-inside space-y-2 text-subtext-light dark:text-subtext-dark"
          >
            <li class="text-text-light dark:text-text-dark">
              Log in to your new session.
            </li>
            <li class="text-text-light dark:text-text-dark">
              Run the first-time setup wizard.
            </li>
            <li class="text-text-light dark:text-text-dark">
              Explore settings to customize your experience.
            </li>
            <li class="text-text-light dark:text-text-dark">
              Check our docs for advanced configuration.
            </li>
          </ul>
        </div>
        <FAQ />
      </div>
    </div>
  </main>
</BaseLayout>
