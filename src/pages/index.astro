---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import BentoGrid from "../components/BentoGrid.astro";
import Footer from "../components/Footer.astro";
import morghulisLogo from "@assets/morghulisText.svg";
import morghulisBackground from "@assets/morghulisFull.webp";
import { Image } from "astro:assets";
---

<BaseLayout title="Morghulis - A Beautifully Crafted Desktop Experience">
  <div id="logo-mask" class="fixed top-0 w-full h-screen">
    <section class="relative h-full">
      <picture id="hero-key" class="h-screen scale-125 block overflow-hidden">
        <Image
          id="hero-key-logo"
          src={morghulisLogo}
          alt="Morghulis Desktop Shell"
          class="absolute left-1/2 top-1/3 -translate-x-1/2 -translate-y-1/2 w-1/2 h-auto z-10"
        />
        <Image
          id="hero-key-background"
          src={morghulisBackground}
          alt="Morghulis Desktop Shell"
          class="w-full h-full object-cover"
        />
      </picture>
    </section>
  </div>
  <Header />
  <main class="flex-1">
    <div class="container mx-auto max-w-5xl px-4 py-16 sm:py-24">
      <Hero />
      <BentoGrid />
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  #logo-mask {
    background: white;
    mask-image: url("/src/assets/morghulisText.svg");
    mask-position: center 25%;
    mask-repeat: no-repeat;
    mask-size: clamp(5000vh, 3500%, 0vh);
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const timeline = gsap.timeline({
    ease: "power2.out",
    scrollTrigger: {
      scrub: 1,
    },
  });

  timeline
    .to("#hero-key-logo", {
      opacity: 0,
    })
    .to(
      "#hero-key",
      {
        scale: 1,
      },
      "<"
    )
    .to(
      "#logo-mask",
      {
        maskSize: "clamp(20vh, 25%, 30vh)",
      },
      0.15
    )
    .to(
      "#hero-key",
      {
        opacity: 0,
        duration: 0.2,
      },
      0.4
    );
</script>
