---
import { Image } from "astro:assets";
import morghulisMain from "@assets/morghulisMain.webp";
---

<section class="flex flex-col items-center gap-8 text-center">
  <div class="flex flex-col gap-4">
    <h1
      class="text-4xl leading-tight font-bold tracking-tighter text-gray-900 sm:text-5xl md:text-6xl dark:text-white"
    >
      A Beautifully Crafted Desktop Experience, Built for Performance
    </h1>
    <h2
      class="text-text-light dark:text-text-dark mx-auto max-w-2xl text-base sm:text-lg"
    >
      Minimal, fast, and customizable. The GTK shell designed for developers and
      creators.
    </h2>
  </div>
  <button
    class="bg-primary-light dark:bg-primary-dark flex h-12 max-w-[480px] min-w-[84px] cursor-pointer items-center justify-center overflow-hidden rounded-lg px-5 text-base leading-normal font-bold tracking-[0.015em] text-gray-800 transition-opacity hover:opacity-90 dark:text-white"
  >
    <span class="truncate">Download Now</span>
  </button>
  <div
    class="bg-card-light dark:bg-card-dark mt-8 w-full rounded-xl border border-black/10 p-2 shadow-lg dark:border-white/10"
  >
    <Image
      class="rounded-xl"
      src={morghulisMain}
      role="img"
      alt="A high-quality screenshot of the Morghulis desktop environment, showcasing its clean interface and modern design."
    />
  </div>
</section>
