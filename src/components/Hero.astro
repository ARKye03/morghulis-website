---
import { Image } from "astro:assets";
import morghulisMain from "@assets/morghulisMain.webp";
---

<section class="flex flex-col items-center gap-8 text-center">
  <div class="flex flex-col gap-4">
    <h1
      class="text-window-fg text-4xl leading-tight font-bold tracking-tighter sm:text-5xl md:text-6xl"
    >
      A Beautifully Crafted Desktop Experience, Built for Performance
    </h1>
    <h2 class="text-window-fg dim-label mx-auto max-w-2xl text-base sm:text-lg">
      Minimal, fast, and customizable. The GTK shell designed for developers and
      creators.
    </h2>
  </div>
  <a
    href="https://github.com/ARKye03/morghulis/releases"
    class="pill suggested-action h-12 max-w-[480px] text-base"
  >
    <span class="truncate">Download Now</span>
  </a>
  <div class="card mt-8 w-full p-2">
    <Image
      class="aspect-video w-full rounded-lg"
      src={morghulisMain}
      alt="A high-quality screenshot of the Morghulis desktop environment, showcasing its clean interface and modern design."
    />
  </div>
</section>
