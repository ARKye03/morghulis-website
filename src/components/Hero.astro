---
import { Image } from "astro:assets";
import morghulisMain from "@assets/morghulisMain.webp";
---

<section class="flex flex-col items-center gap-8 text-center">
  <div class="flex flex-col gap-4">
    <h1
      class="text-4xl font-bold leading-tight tracking-tighter sm:text-5xl md:text-6xl text-gray-900 dark:text-white"
    >
      A Beautifully Crafted Desktop Experience, Built for Performance
    </h1>
    <h2
      class="max-w-2xl text-base sm:text-lg mx-auto text-text-light dark:text-text-dark"
    >
      Minimal, fast, and customizable. The GTK shell designed for developers and
      creators.
    </h2>
  </div>
  <button
    class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-12 px-5 bg-primary-light dark:bg-primary-dark text-gray-800 dark:text-white text-base font-bold leading-normal tracking-[0.015em] transition-opacity hover:opacity-90"
  >
    <span class="truncate">Download Now</span>
  </button>
  <div
    class="w-full mt-8 rounded-xl border border-black/10 dark:border-white/10 p-2 bg-card-light dark:bg-card-dark shadow-lg"
  >
    <Image
      class="rounded-xl"
      src={morghulisMain}
      role="img"
      alt="A high-quality screenshot of the Morghulis desktop environment, showcasing its clean interface and modern design."
    />
  </div>
</section>
