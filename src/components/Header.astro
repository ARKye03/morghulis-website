---
import ThemeToggle from "./ThemeToggle.astro";
---

<header
  id="main-header"
  class="bg-headerbar-bg/80 text-headerbar-fg border-headerbar-shade sticky top-0 z-50 w-full border-b backdrop-blur-sm"
>
  <div
    class="container mx-auto flex h-16 max-w-5xl items-center justify-between px-4"
  >
    <a href="/" class="flex items-center gap-3">
      <span class="icon-[dinkie-icons--dragon-face] text-accent text-2xl"
      ></span>

      <h2 class="text-base font-bold">Morghulis</h2>
    </a>
    <div class="flex items-center gap-2">
      <a
        href="/configuration"
        class="hover:bg-shade rounded-pill hidden px-3 py-2 text-sm font-medium transition-colors sm:inline-block"
      >
        Configuration
      </a>
      <ThemeToggle />
      <a href="/installation" class="pill suggested-action px-5 text-sm">
        <span class="truncate">Get Started</span>
      </a>
    </div>
  </div>
</header>
