---
import { Image } from "astro:assets";
import morghulisQS from "@assets/morghulisQS.webp";
---

<section class="mt-24 sm:mt-32">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div
      class="md:col-span-2 md:row-span-2 group relative flex flex-col justify-end overflow-hidden rounded-xl border border-black/10 dark:border-white/10 bg-card-light dark:bg-card-dark p-6 shadow-md transition-shadow hover:shadow-xl"
    >
      <div class="absolute inset-0 z-0">
        <Image
          src={morghulisQS}
          alt="Morghulis Desktop Shell Showcase"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
        <div
          class="absolute inset-0 bg-linear-to-t from-black/80 to-transparent"
        >
        </div>
      </div>
      <div class="relative z-10">
        <h3 class="text-xl font-bold text-white">Stunning Visuals & Theming</h3>
        <p class="text-sm text-gray-300 mt-1">
          Showcasing the UI with different themes applied.
        </p>
      </div>
    </div>

    <div
      class="flex flex-col gap-4 rounded-xl border border-black/10 dark:border-white/10 bg-card-light dark:bg-card-dark p-6 shadow-md transition-shadow hover:shadow-xl"
    >
      <div
        class="flex h-12 w-12 items-center justify-center rounded-lg bg-primary-light/20 dark:bg-primary-dark/20 text-primary-light dark:text-primary-dark"
      >
        <span class="icon-[material-symbols--bolt] text-3xl"></span>
      </div>
      <div>
        <h3 class="text-base font-bold text-gray-900 dark:text-white">
          Blazing Fast Performance
        </h3>
        <p class="text-sm text-text-light dark:text-text-dark mt-1">
          A brief note on its lightweight nature.
        </p>
      </div>
    </div>

    <div
      class="flex flex-col gap-4 rounded-xl border border-black/10 dark:border-white/10 bg-card-light dark:bg-card-dark p-6 shadow-md transition-shadow hover:shadow-xl"
    >
      <div
        class="flex h-12 w-12 items-center justify-center rounded-lg bg-primary-light/20 dark:bg-primary-dark/20 text-primary-light dark:text-primary-dark"
      >
        <span class="icon-[cil--view-quilt] text-3xl"></span>
      </div>
      <div>
        <h3 class="text-base font-bold text-gray-900 dark:text-white">
          Powerful Window Management
        </h3>
        <p class="text-sm text-text-light dark:text-text-dark mt-1">
          Demonstrating tiling and workspaces.
        </p>
      </div>
    </div>

    <div
      class="flex flex-col justify-between rounded-xl border border-black/10 dark:border-white/10 bg-card-light dark:bg-card-dark p-6 shadow-md transition-shadow hover:shadow-xl"
    >
      <div>
        <h3 class="text-base font-bold text-gray-900 dark:text-white">
          Extensible & Customizable
        </h3>
        <p class="text-sm text-text-light dark:text-text-dark mt-1">
          Highlighting plugin support and configuration options.
        </p>
      </div>
      <div class="mt-4 flex -space-x-2">
        <span
          class="flex h-8 w-8 items-center justify-center rounded-full bg-gray-200 dark:bg-gray-700 text-text-light dark:text-text-dark border-2 border-card-light dark:border-card-dark text-sm font-bold"
        >
          P1
        </span>
        <span
          class="flex h-8 w-8 items-center justify-center rounded-full bg-gray-200 dark:bg-gray-700 text-text-light dark:text-text-dark border-2 border-card-light dark:border-card-dark text-sm font-bold"
        >
          P2
        </span>
        <span
          class="flex h-8 w-8 items-center justify-center rounded-full bg-gray-200 dark:bg-gray-700 text-text-light dark:text-text-dark border-2 border-card-light dark:border-card-dark text-sm font-bold"
        >
          P3
        </span>
      </div>
    </div>

    <div
      class="flex flex-col items-center justify-center gap-4 rounded-xl border border-black/10 dark:border-white/10 bg-card-light dark:bg-card-dark p-6 shadow-md transition-shadow hover:shadow-xl"
    >
      <h3 class="text-base font-bold text-gray-900 dark:text-white">
        Built with GTK4 & Vala
      </h3>
      <div class="flex items-center gap-6 text-5xl">
        <span class="icon-[skill-icons--gtk-dark]"></span>
        <span class="icon-[material-icon-theme--vala]"></span>
      </div>
    </div>

    <div
      class="flex flex-col items-center justify-center text-center gap-4 rounded-xl border border-black/10 dark:border-white/10 bg-primary-light/10 dark:bg-primary-dark/10 p-6 shadow-md transition-shadow hover:shadow-xl"
    >
      <h3 class="text-xl font-bold text-gray-900 dark:text-white">
        Ready to Dive In?
      </h3>
      <p class="text-sm text-text-light dark:text-text-dark">
        Explore the installation guide or check out the source code.
      </p>
      <a
        class="button-arrow mt-2 inline-block relative rounded-lg bg-primary-light dark:bg-primary-dark text-white text-center p-4 w-[220px] transition-all duration-500 cursor-pointer shadow-xl border-none hover:pr-6 hover:pl-2 text-sm font-bold leading-normal tracking-[0.015em]"
        href="/installation"
      >
        Get Started
      </a>
    </div>
  </div>
</section>
