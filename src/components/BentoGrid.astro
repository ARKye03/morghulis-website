---
import { Image } from "astro:assets";
import morghulisFilled from "@assets/morghulisFilled.webp";
import adwaitaLogo from "@assets/adwaitaLogo.svg";
---

<section class="mt-12 px-4 sm:mt-24 sm:px-6 md:mt-32">
  <div class="grid grid-cols-1 gap-4 sm:gap-6 md:grid-cols-3">
    <div
      class="group card relative flex min-h-[280px] flex-col justify-end overflow-hidden p-6 sm:min-h-[320px] sm:p-8 md:col-span-2 md:row-span-2"
    >
      <div class="absolute inset-0 z-0">
        <Image
          src={morghulisFilled}
          alt="Morghulis Desktop Shell Showcase"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          loading="lazy"
        />
        <div
          class="absolute inset-0 bg-linear-to-t from-black/90 via-black/50 to-transparent"
        >
        </div>
      </div>
      <div class="relative z-10">
        <h3 class="text-xl font-bold text-white sm:text-2xl">
          Stunning Visuals & Theming
        </h3>
        <p class="mt-2 text-sm text-white/80 sm:text-base">
          Showcasing the UI with different themes applied.
        </p>
      </div>
    </div>

    <div class="card flex flex-col gap-4 p-6">
      <div
        class="bg-accent-bg/15 text-accent rounded-card flex h-12 w-12 items-center justify-center"
      >
        <span class="icon-[material-symbols--bolt] text-3xl"></span>
      </div>
      <div>
        <h3 class="text-base font-bold sm:text-lg">Blazing Fast Performance</h3>
        <p class="dim-label mt-1 text-sm sm:text-base">
          A brief note on its lightweight nature.
        </p>
      </div>
    </div>

    <div class="card flex flex-col gap-4 p-6">
      <div
        class="bg-accent-bg/15 text-accent rounded-card flex h-12 w-12 items-center justify-center"
      >
        <span class="icon-[cil--view-quilt] text-3xl"></span>
      </div>
      <div>
        <h3 class="text-base font-bold sm:text-lg">
          Powerful Window Management
        </h3>
        <p class="dim-label mt-1 text-sm sm:text-base">
          Demonstrating tiling and workspaces.
        </p>
      </div>
    </div>

    <div class="card flex flex-col justify-between p-6">
      <div>
        <h3 class="text-base font-bold sm:text-lg">
          Extensible & Customizable
        </h3>
        <p class="dim-label mt-1 text-sm sm:text-base">
          Highlighting plugin support and configuration options.
        </p>
      </div>
      <div class="mt-4 flex -space-x-1">
        <span
          class="bg-accent-bg text-accent-fg ring-view-bg flex h-8 w-8 items-center justify-center rounded-full text-sm font-bold ring-2"
        >
          P1
        </span>
        <span
          class="bg-accent-bg text-accent-fg ring-view-bg flex h-8 w-8 items-center justify-center rounded-full text-sm font-bold ring-2"
        >
          P2
        </span>
        <span
          class="bg-accent-bg text-accent-fg ring-view-bg flex h-8 w-8 items-center justify-center rounded-full text-sm font-bold ring-2"
        >
          P3
        </span>
      </div>
    </div>

    <div class="card flex flex-col items-center justify-center gap-4 p-6">
      <h3 class="text-center text-base font-bold sm:text-lg">
        Built with GTK4, Adwaita, and Vala
      </h3>
      <div class="flex items-center gap-6 text-5xl">
        <span class="icon-[skill-icons--gtk-dark]"></span>
        <span class="icon-[material-icon-theme--vala]"></span>
        <Image src={adwaitaLogo} alt="Adwaita Logo" class="h-10 w-10" />
      </div>
    </div>

    <div
      class="card flex flex-col items-center justify-center gap-4 p-6 text-center"
    >
      <h3 class="text-lg font-bold sm:text-xl">Ready to Dive In?</h3>
      <p class="dim-label text-sm sm:text-base">
        Explore the installation guide or check out the source code.
      </p>
      <a
        class="button-arrow pill suggested-action relative mt-2 w-full max-w-[280px] text-sm transition-all duration-500 hover:pr-10 hover:pl-6 sm:w-[220px]"
        href="/installation"
      >
        Get Started
      </a>
    </div>
  </div>
</section>
