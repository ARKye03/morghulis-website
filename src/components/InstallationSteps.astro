---
import { Code } from "astro/components";
---

<div
  class="bg-card-light dark:bg-card-dark col-span-1 rounded-xl p-6 lg:col-span-2 lg:row-span-2"
>
  <h2 class="mb-4 text-xl font-bold">Installation Steps</h2>

  <div class="space-y-8">
    <div>
      <h3 class="mb-4 text-lg font-bold">Arch Linux</h3>
      <ol
        class="text-subtext-light dark:text-subtext-dark list-inside list-decimal space-y-4"
      >
        <li>
          <span class="text-text-light dark:text-text-dark font-medium"
            >Install from AUR:</span
          >
          <Code
            class="mt-2 rounded-md p-2"
            code={`yay -S morghulis-git`}
            lang="sh"
          />
        </li>
        <li>
          <span class="text-text-light dark:text-text-dark font-medium"
            >Just launch it:</span
          >
          <Code
            class="mt-2 rounded-md p-2"
            code={`morghulis --help`}
            lang="sh"
          />
        </li>
      </ol>
    </div>

    <div>
      <h3 class="mb-4 text-lg font-bold">Build from source</h3>
      <ol
        class="text-subtext-light dark:text-subtext-dark list-inside list-decimal space-y-4"
      >
        <li>
          <span class="text-text-light dark:text-text-dark font-medium"
            >Clone the repository:</span
          >
          <Code
            class="mt-2 rounded-md p-2"
            code={`git clone https://github.com/ARKye03/morghulis.git`}
            lang="sh"
          />
        </li>
        <li>
          <span class="text-text-light dark:text-text-dark font-medium"
            >Build the project:</span
          >
          <Code
            class="mt-2 rounded-md p-2"
            code={`cd morghulis; just build`}
            lang="sh"
          />
        </li>
        <li>
          <span class="text-text-light dark:text-text-dark font-medium"
            >Run it:</span
          >
          <Code class="mt-2 rounded-md p-2" code={`just`} lang="sh" />
        </li>
      </ol>
    </div>
  </div>
</div>
