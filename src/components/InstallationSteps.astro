---
import { Code } from "astro/components";
---

<section class="lg:col-span-2">
  <h2 class="mb-3 px-1 text-sm font-bold">Install</h2>
  <div class="card boxed-list">
    <div class="p-6">
      <h3 class="mb-4 flex items-center gap-2 text-lg font-bold">
        <span class="icon-[lucide--package] text-accent"></span>
        Arch Linux
      </h3>
      <ol class="list-inside list-decimal space-y-4">
        <li>
          <span class="font-medium">Install from the AUR with any helper:</span>
          <Code
            class="mt-2 rounded-md p-2"
            code={`yay -S morghulis-git`}
            lang="sh"
          />
        </li>
        <li>
          <span class="font-medium">Run it:</span>
          <Code
            class="mt-2 rounded-md p-2"
            code={`morghulis --help`}
            lang="sh"
          />
        </li>
      </ol>
      <p class="mt-4 text-sm">
        <span class="dim-label">Prefer the latest release binary? Use the</span
        >{" "}
        <a
          class="text-accent underline"
          href="https://raw.githubusercontent.com/ARKye03/PKGBUILDS/refs/heads/trunk/morghulis-bin/PKGBUILD"
          >morghulis-bin PKGBUILD</a
        >.
      </p>
    </div>

    <div class="p-6">
      <h3 class="mb-4 flex items-center gap-2 text-lg font-bold">
        <span class="icon-[lucide--hammer] text-accent"></span>
        From source
      </h3>
      <ol class="list-inside list-decimal space-y-4">
        <li>
          <span class="font-medium">Clone the repository:</span>
          <Code
            class="mt-2 rounded-md p-2"
            code={`git clone https://github.com/ARKye03/morghulis
cd morghulis`}
            lang="sh"
          />
        </li>
        <li>
          <span class="font-medium">Set up the build and install:</span>
          <Code
            class="mt-2 rounded-md p-2"
            code={`just init
just install`}
            lang="sh"
          />
        </li>
      </ol>
    </div>
  </div>
</section>
